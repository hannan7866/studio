
# Firebase Project Configuration
# Copy this file to .env.local and replace the placeholder values with your actual Firebase project credentials.
# You can find these values in your Firebase project console:
# Project settings > General > Your apps > Firebase SDK snippet (select Config).

# Required: Your Firebase project's API key.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE

# Required: Your Firebase project's authentication domain.
# Example: your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN_HERE

# Required: Your Firebase project's ID.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE

# Required: Your Firebase project's Cloud Storage bucket.
# Example: your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET_HERE

# Required: Your Firebase project's messaging sender ID.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE

# Required: Your Firebase project's app ID.
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID_HERE

# Optional: Your Firebase project's measurement ID (for Google Analytics).
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID_HERE
